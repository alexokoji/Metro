# Backend Environment Variables
# Copy this file to .env and update with your actual values

# MongoDB Connection String
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/primesolutions?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/primesolutions

# JWT Secret - Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here

# Node Environment
NODE_ENV=development

# Frontend Origin - Update this to your frontend URL when deploying
# Development: http://localhost:5173
# Production: https://your-netlify-site.netlify.app
FRONTEND_ORIGIN=http://localhost:5173

# Port (Render will assign automatically in production)
PORT=5001
