# Backend Environment Variables (Next.js on Vercel)
# Copy this file to .env and update with your actual values.
# On Vercel, set these under Project Settings -> Environment Variables instead.

# MongoDB Connection String
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/primesolutions?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/primesolutions

# JWT Secret - Generate with: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here

# Node Environment
NODE_ENV=development

# Frontend Origin(s) allowed by CORS - comma-separated if more than one
# Development: http://localhost:5173
# Production: https://your-netlify-site.netlify.app
FRONTEND_ORIGIN=http://localhost:5173

# Used only by `npm run seed-admin` (scripts/seed-admin.ts), run manually - not read at request time
ADMIN_EMAIL=
ADMIN_PASSWORD=
